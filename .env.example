# Copy to .env (git-ignored). Values come from Supabase → Project Settings → API.
# The anon key is a public key; the database is protected by row-level security.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google native sign-in (development / Play builds). The WEB client ID from Google Cloud, not the Android one.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com
